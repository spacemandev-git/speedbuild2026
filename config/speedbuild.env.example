# Number of participant tenants provisioned for a full competition.
SB_PARTICIPANT_COUNT=30
# First participant SSH port is this base plus the participant number (p01 = 2201).
SB_SSH_PORT_BASE=2200

# Incus managed bridge used by all Speedbuild tenants.
SB_BRIDGE_NAME=sbbr0
# First three octets used when deriving participant tenant addresses.
SB_SUBNET_PREFIX=10.61.0

# Required shared secret for deterministic Estate challenge values.
# Generate with: openssl rand -hex 32
SB_ESTATE_SECRET=
# Required bearer token for executor-api administration and dashboard login.
# Generate with: openssl rand -hex 32
SB_ADMIN_TOKEN=
# Required bearer token for the host-agent API.
# Generate with: openssl rand -hex 32
SB_HOST_AGENT_TOKEN=

# Size of the ZFS loop-backed storage pool created for Incus.
SB_ZPOOL_SIZE=2000GiB
# Persistent host directory mounted into the inference tenant at /models.
SB_MODELS_DIR=/var/lib/speedbuild/models

# Hugging Face repository containing the production GGUF model.
SB_MODEL_HF_REPO=unsloth/GLM-5.2-GGUF
# Quantization filename selector used by the model download script.
SB_MODEL_QUANT=UD-Q2_K_XL
# OpenAI-compatible model alias exposed by llama-server.
SB_MODEL_ALIAS=glm-5.2

# CPU worker threads used by llama-server.
SB_LLAMA_THREADS=48
# Number of parallel llama-server request slots.
SB_LLAMA_PARALLEL=4
# Total context tokens divided across all parallel request slots.
SB_LLAMA_CTX_TOTAL=262144

# Production CPU limit for the inference zone.
SB_INFER_CPUS=48
# Production memory limit for the inference zone.
SB_INFER_MEM=640GiB
# Production CPU limit for the challenges zone.
SB_CHAL_CPUS=12
# Production memory limit for the challenges zone.
SB_CHAL_MEM=64GiB
# Production CPU limit for the admin zone.
SB_ADMIN_CPUS=8
# Production memory limit for the admin zone.
SB_ADMIN_MEM=24GiB
# CPU limit for each participant tenant.
SB_PART_CPUS=4
# Memory limit for each participant tenant.
SB_PART_MEM=8GiB
# Root disk limit for each participant tenant.
SB_PART_DISK=30GiB

# Production tenants are VMs; smoke tests force container mode.
SB_TENANT_MODE=vm
# Set to 0 to skip all SR-IOV/IOMMU setup and VF profile attachment.
SB_SRIOV_ENABLE=1
# SR-IOV-capable NIC PF host netdev (e.g. Intel E810 ice port enp1s0f0np0, or an
# E2100 IPU idpf PF). Find it with `ip -o link`; required when SR-IOV is enabled.
SB_SRIOV_PF=
# Number of virtual functions to create persistently on the PF.
SB_SRIOV_VF_COUNT=40

# Set to 1 for the two-participant, tiny-model smoke-test configuration.
SB_SMOKE_TEST=0
