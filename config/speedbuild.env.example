# Number of participant tenants provisioned for a full competition.
SB_PARTICIPANT_COUNT=30
# First participant SSH port is this base plus the participant number (p01 = 2201).
SB_SSH_PORT_BASE=2200

# Incus managed bridge used by all Speedbuild tenants.
SB_BRIDGE_NAME=sbbr0
# First three octets used when deriving participant tenant addresses.
SB_SUBNET_PREFIX=10.61.0

# Required HMAC seed for every deterministic unlock code.
# Generate with: openssl rand -hex 32
SB_BUREAU_SECRET=
# How many operative IDs get pre-generated codes/locks (min 16).
# IDs are assigned at check-in; extras are reserves.
SB_OPERATIVE_POOL=24
# Required bearer token for Bureau API administration and dashboard login.
# Generate with: openssl rand -hex 32
SB_ADMIN_TOKEN=
# Browser-facing origin of the admin dashboard: the host's public IP or domain
# plus the dashboard proxy port (8080). Required so login POSTs pass SvelteKit's
# CSRF origin check when the dashboard is reached through the host proxy.
# Example: http://203.0.113.10:8080  (leave blank only for direct localhost use)
SB_DASHBOARD_ORIGIN=
# Required bearer token for the host-agent API.
# Generate with: openssl rand -hex 32
SB_HOST_AGENT_TOKEN=

# Size of the ZFS loop-backed storage pool created for Incus.
SB_ZPOOL_SIZE=2000GiB

# Shared OpenRouter key used by the participant OpenCode config. OpenRouter is
# the only model path and serves the default openai/gpt-5.6-sol; z-ai/glm-5.2
# remains configured as a selectable alternative.
# Pushed into each tenant's environment as SUNBURST_OR_KEY and referenced by
# opencode.json ({env:SUNBURST_OR_KEY}). Leave blank to disable model access.
SUNBURST_OR_KEY=

# Production CPU limit for the challenges zone.
SB_CHAL_CPUS=12
# Production memory limit for the challenges zone.
SB_CHAL_MEM=64GiB
# Production CPU limit for the admin zone.
SB_ADMIN_CPUS=8
# Production memory limit for the admin zone.
SB_ADMIN_MEM=24GiB
# CPU limit for each participant tenant.
SB_PART_CPUS=4
# Memory limit for each participant tenant.
SB_PART_MEM=8GiB
# Root disk limit for each participant tenant.
SB_PART_DISK=30GiB

# Tenant isolation mode: `container` (Incus system containers; the validated,
# default operating mode) or `vm` (Incus VMs, required for real SR-IOV/VFIO
# passthrough). Enable `vm` + SR-IOV ONLY on a host with a DEDICATED (non-bonded)
# SR-IOV NIC port and out-of-band/console recovery — creating VFs on a bonded
# management port can drop host connectivity.
SB_TENANT_MODE=container
# 1 enables SR-IOV/IOMMU host setup + VF profile attachment (requires vm mode +
# SB_SRIOV_PF + a dedicated data port). 0 skips it entirely (container mode).
SB_SRIOV_ENABLE=0
# SR-IOV-capable NIC PF host netdev (e.g. Intel E810 ice port enp1s0f0np0, or an
# E2100 IPU idpf PF). Find it with `ip -o link`; required only when SR-IOV enabled.
SB_SRIOV_PF=
# Number of virtual functions to create persistently on the PF.
SB_SRIOV_VF_COUNT=40

# Set to 1 for the two-participant, tiny-model smoke-test configuration.
SB_SMOKE_TEST=0
