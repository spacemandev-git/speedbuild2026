[Unit]
Description=Speedbuild llama.cpp inference server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# NON-THINKING mode by default: Qwen3.6's thinking trace makes each agentic
# OpenCode turn far too slow on CPU (a reasoning dump before every tool call).
# enable_thinking:false + Qwen's non-thinking sampling (temp 0.7, top-p 0.8,
# top-k 20, min-p 0.0, presence-penalty 1.5). To re-enable deeper reasoning at a
# large speed cost, drop the chat-template-kwargs flag and use temp 1.0/top-p 0.95.
# --mlock is intentionally omitted: mmap keeps the model in page cache on a 1TB
# box, and mlock of tens of GB fails under an unprivileged container's limit.
ExecStart=/opt/llama.cpp/build/bin/llama-server --model ${MODEL_PATH} --alias ${SB_MODEL_ALIAS} --host 0.0.0.0 --port 8080 --api-key-file /etc/llama/api-keys.txt --threads ${SB_LLAMA_THREADS} --ctx-size ${SB_LLAMA_CTX_TOTAL} --parallel ${SB_LLAMA_PARALLEL} --cache-type-k q8_0 --cache-type-v q8_0 --flash-attn on --jinja --chat-template-kwargs '{"enable_thinking":false}' --temp 0.7 --top-p 0.8 --top-k 20 --min-p 0.0 --presence-penalty 1.5
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
