{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/z-ai/glm-5.2",
  "mcp": {
    "solana": {
      "type": "remote",
      "url": "https://mcp.solana.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{env:SUNBURST_OR_KEY}"
      },
      "models": {
        "z-ai/glm-5.2": {
          "limit": {
            "context": ${SB_OPENCODE_CTX},
            "output": 32768
          }
        }
      }
    },
    "estate": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Estate Inference",
      "options": {
        "baseURL": "http://10.61.0.30:8080/v1",
        "apiKey": "{env:ESTATE_API_KEY}"
      },
      "models": {
        "${SB_MODEL_ALIAS}": {
          "limit": {
            "context": ${SB_OPENCODE_CTX},
            "output": 32768
          }
        }
      }
    }
  }
}
